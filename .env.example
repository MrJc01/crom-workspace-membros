# ================================================
# CROM Multi-VPS Environment Configuration
# ================================================
# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env

# VPS 0 — Nome descritivo
VPS0_HOST=""
VPS0_USER="root"
VPS0_PASS=""
VPS0_NAME="vps0"

# VPS 1
VPS1_HOST=""
VPS1_USER="root"
VPS1_PASS=""
VPS1_NAME="vps1"

# VPS 2
VPS2_HOST=""
VPS2_USER="root"
VPS2_PASS=""
VPS2_NAME="vps2"

# Padrão: qual VPS conectar ao iniciar
VPS_ATIVA=0
